NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/civicpulse

# JWT Configuration
JWT_SECRET=civicpulse-jwt-secret-change-in-production
JWT_REFRESH_SECRET=civicpulse-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AWS S3 Configuration (leave blank for mock mode)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=civicpulse-uploads

# Firebase Cloud Messaging (leave blank for console-only notifications)
FCM_SERVICE_ACCOUNT_PATH=

# SLA Configuration
SLA_TARGET_HOURS=24
